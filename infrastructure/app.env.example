# Spatial Power application configuration.
#
# Stored per tier at s3://<CICD_BUCKET>/env/<tier>/spatial-power/app.env and
# downloaded by .github/workflows/deploy-serverless-infrastructure.yml.
#
# Every key here is published by the app stack as an SSM parameter
#   /analysistools/<tier>/spatial-power/<key lowercased>
# and consumed by the web task's backend and queue containers as ECS secrets
# (see .github/aws/web.yml). Adding a key here adds a parameter -- no code
# change is required.
#
# Infrastructure settings (VPC, subnets, sizing, listener rule priority) belong
# in cdk.env. Keys here must not collide with any key in cdk.env, since both
# files are loaded into the same deploy job.

BASE_URL=https://analysistools-dev.cancer.gov/spatial-power
EMAIL_ADMIN=NCISpatialPowerWebAdmin@nih.gov
EMAIL_SENDER=NCISpatialPowerWebAdmin@nih.gov
EMAIL_SMTP_HOST=mailfwd.nih.gov
EMAIL_SMTP_PORT=25
